{
  // The main tsconfig excludes **/*.test.ts, so `pnpm type-check` could not see the
  // suite. That is how a signature change to interpretRemoveResult — the function this
  // PR has fixed five times — type-checked clean while eight tests passed a boolean
  // where an object was now required, silently taking the "inconclusive" branch and
  // reporting a false success. Cheapest available guard against the next iteration.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false
  },
  // convex/ is likewise outside the main tsconfig, and it stopped being
  // self-contained when submissions.ts began importing scrub from src/: a
  // signature change there type-checks clean across all of src/ while
  // silently breaking the Convex caller, which nothing else here compiles.
  // Its generated bindings are committed — per Convex's own `codegen --help`,
  // they "should be committed to the repo (your code won't typecheck without
  // it!)" — so this needs neither network nor deploy credentials in CI.
  "include": [
    "src/**/*",
    "api/**/*",
    "scripts/**/*",
    "tests/**/*",
    "convex/**/*"
  ],
  "exclude": ["dist", "build", "node_modules"]
}
